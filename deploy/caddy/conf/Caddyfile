# Caddy compartido detrás de Cloudflare. Un archivo por juego en sites/.
#   TLS_MODE → "origin"   certificado de origen (comodín) en /etc/caddy/certs (producción)
#              "internal" certificado autofirmado (pruebas locales sin Cloudflare)
{
	# El 80 no se publica: sin redirecciones HTTP→HTTPS que nadie va a recibir.
	auto_https disable_redirects

	servers {
		# La IP real del jugador llega en Cf-Connecting-Ip; solo nos fiamos de Cloudflare.
		# Lista actualizada en https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}

	# Registro general (errores de los sitios, p. ej. un 502 al reiniciar un servidor): sin la IP del visitante ni
	# la clave de invitación (?k=) de las URL. Los registros de acceso de cada sitio van aparte (su propio `log`).
	log default {
		output stderr
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>Cf-Connecting-Ipv6 delete
				request>headers>Cf-Pseudo-Ipv4 delete
				request>headers>X-Forwarded-For delete
				request>headers>True-Client-Ip delete
				request>headers>Cf-Ipcountry delete
				request>uri query {
					replace k REDACTADA
				}
			}
		}
	}
}

(tls_origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

(tls_internal) {
	tls internal
}

# Cabeceras comunes a todos los sitios
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Registro de acceso (solo avisos y errores) sin la IP del visitante: los mismos campos que el registro general.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>Cf-Connecting-Ipv6 delete
				request>headers>Cf-Pseudo-Ipv4 delete
				request>headers>X-Forwarded-For delete
				request>headers>True-Client-Ip delete
				request>headers>Cf-Ipcountry delete
			}
		}
		level WARN
	}
}

import /etc/caddy/conf/sites/*.caddy
