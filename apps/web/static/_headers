# Cabeceras de los assets estáticos en Cloudflare Workers (en el VPS las pone Caddy).

# Nombres con hash de contenido: se pueden cachear para siempre.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# La fuente tiene nombre fijo: si cambia, cambia también su nombre.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
