{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jaque",
  // Cuenta Gusideveloper
  "account_id": "d1f835df40f3c1f57b847482a58ed772",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },

  // Frontend estático (SvelteKit). El Worker va primero en todas las rutas: atiende
  // /api y /ws, fija el dominio canónico y sirve los assets con el fallback de la
  // SPA (200.html), devolviendo 404 en las rutas que no son partidas (src/site.ts).
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // Producción: damejaque.online es el dominio canónico (www y workers.dev redirigen).
  "vars": {
    "ENVIRONMENT": "production",
    "CANONICAL_HOST": "damejaque.online"
  },

  // Custom Domains del Worker (la zona está en esta cuenta; DNS y certificado automáticos).
  // Las Previews no los usan.
  "routes": [
    { "pattern": "damejaque.online", "custom_domain": true },
    { "pattern": "www.damejaque.online", "custom_domain": true }
  ],
  // Con routes, wrangler apaga workers.dev si no se indica: lo necesitan las URL de
  // las Previews, y en producción redirige al dominio (src/site.ts).
  "workers_dev": true,
  "preview_urls": true,

  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],

  // Historial de partidas terminadas (producción).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaque",
      "database_id": "e6116ccd-b1a1-4dab-9d89-ea05c1daae42",
      "migrations_dir": "migrations"
    }
  ],

  // POST /api/games: 20 partidas por minuto e IP.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Previews (rama develop y cualquier otra que no sea main). Cada Preview tiene
  // sus propios Durable Objects; D1 y el límite de peticiones apuntan a recursos
  // de desarrollo para no tocar los de producción.
  // Si cambias la D1 de aquí, cambia también wrangler.preview-migrations.jsonc.
  "previews": {
    // Las Previews no se indexan ni redirigen al dominio.
    "vars": {
      "ENVIRONMENT": "preview",
      "CANONICAL_HOST": ""
    },
    "durable_objects": {
      "bindings": [
        { "name": "GAME_ROOM", "class_name": "GameRoom" },
        { "name": "LOBBY", "class_name": "Lobby" }
      ]
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "jaque-develop",
        "database_id": "5465a498-c6c0-4f31-b171-b0f2f3565a09"
      }
    ],
    "ratelimits": [
      {
        "name": "CREATE_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }
}
